# Template .env untuk produksi (VM) — salin jadi `.env` di root project pada
# VM, lalu isi semua nilai <GANTI...> dengan yang asli. File ini dipakai
# dobel oleh docker-compose.prod.yml: (1) untuk substitusi ${POSTGRES_PASSWORD}
# di compose sendiri, (2) di-pass ke container `app` lewat `env_file`.
# JANGAN commit file `.env` (sudah di-gitignore) — hanya .env.production.example
# ini (tanpa nilai asli) yang boleh masuk git.

# Password Postgres produksi — generate baru, JANGAN pakai nilai dev "cyasset".
# mis: openssl rand -base64 24
POSTGRES_PASSWORD="<GANTI-password-postgres-kuat>"

# DATABASE_URL di sini tidak dipakai langsung oleh container `app` (di-override
# otomatis oleh docker-compose.prod.yml supaya selalu nunjuk ke service `db`),
# tapi tetap harus diisi format valid karena dibaca saat build image.
DATABASE_URL="postgresql://cyasset:<GANTI-password-postgres-kuat>@db:5432/cyasset"

# Generate baru khusus produksi, JANGAN pakai AUTH_SECRET dari .env dev.
# mis: npx auth secret (atau: openssl rand -base64 32)
AUTH_SECRET="<GANTI-auth-secret-baru>"

# Domain publik aplikasi — dipakai buat encode URL ke QR Code.
APP_URL="https://cyasset.cybermedia.sch.id"

# Dipakai SEKALI SAJA saat menjalankan `npm run db:seed` pertama kali untuk
# membuat akun Admin Sarpras awal dengan password asli (bukan contoh dari
# scripts/seed.ts). Boleh dihapus dari .env setelah seed berhasil dijalankan.
ADMIN_NAME="<Nama Admin Sarpras>"
ADMIN_USERNAME="<username-admin>"
ADMIN_EMAIL="<email-admin>@cybermedia.sch.id"
ADMIN_PASSWORD="<GANTI-password-admin-kuat>"
